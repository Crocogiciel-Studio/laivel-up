{
  "name": "laivel-up-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: the laivel-up evaluation engine (packages/core) and the studio delivery layer (packages/studio-*)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "typecheck": "pnpm -C packages/core typecheck",
    "lint": "pnpm -C packages/core lint",
    "lint:fix": "pnpm -C packages/core lint:fix",
    "test": "pnpm -C packages/core test",
    "depcruise": "pnpm -C packages/core depcruise",
    "i18n:check": "pnpm -C packages/core i18n:check",
    "build": "pnpm -C packages/core build",
    "dev": "pnpm -C packages/core dev",
    "viz": "pnpm -C packages/core viz",
    "templates:check": "pnpm -C packages/studio-db templates:check",
    "db:new": "pnpm -C packages/studio-db db:new",
    "db:seed:templates": "pnpm -C packages/studio-db db:seed:templates",
    "db:link": "pnpm -C packages/studio-db db:link",
    "db:push": "pnpm -C packages/studio-db db:push",
    "db:test": "pnpm -C packages/studio-db db:test",
    "db:test:bare": "pnpm -C packages/studio-db db:test:bare",
    "db:start": "pnpm -C packages/studio-db db:start",
    "db:stop": "pnpm -C packages/studio-db db:stop",
    "db:status": "pnpm -C packages/studio-db db:status",
    "db:reset": "pnpm -C packages/studio-db db:reset"
  }
}
