# Studio environment. Copy to `.env` and fill in. `.env` is git-ignored.
#
# `pnpm db:start` prints the local anon key, service-role key, and URLs; paste
# them here so the backend (issue #56) and web app (issue #57) can reach the
# local Supabase stack.

# --- Supabase (local stack) --------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used by migrations and the RLS smoke test.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- OAuth providers -------------------------------------------------------------
# Enable the matching [auth.external.*] block in supabase/config.toml, then set
# the credentials here. At least one provider must be enabled for sign-in.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Studio web app ------------------------------------------------------------
# Where the browser reaches the app; must match site_url / additional_redirect_urls
# in supabase/config.toml.
STUDIO_SITE_URL=http://127.0.0.1:5173
