# Studio environment. Copy to `.env` and fill in. `.env` is git-ignored.
#
# The studio talks to a Supabase project by URL + keys, so this file is the same
# whether that project is Supabase Cloud (the default for a multi-user
# deployment) or a local stack from `supabase start` (offline dev).

# --- Supabase project --------------------------------------------------------
# Cloud: Project Settings -> API in the dashboard.
# Local: the values `pnpm db:start` prints (URL is http://127.0.0.1:54321).
SUPABASE_URL=https://rvzocjdbpmjzanutijwe.supabase.co
SUPABASE_ANON_KEY=
# Direct Postgres connection -- only for `pnpm db:test` against a local or
# throwaway database. The server never uses it.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Studio backend (ui/server) ----------------------------------------------
HOST=0.0.0.0
PORT=8787
# CORS allow-list for the web app (comma-separated). The default covers the dev
# server opened as either host; add your deployed origin for production.
STUDIO_SITE_URL=http://localhost:5173,http://127.0.0.1:5173

# --- Studio web app (ui/web) -------------------------------------------------
# Vite exposes only VITE_-prefixed vars to the browser, and bakes them at build
# time. Same project as above; the anon key is safe to ship to the client.
VITE_SUPABASE_URL=https://rvzocjdbpmjzanutijwe.supabase.co
VITE_SUPABASE_ANON_KEY=
# The studio backend, as the browser reaches it.
VITE_API_URL=http://localhost:8787

# --- OAuth providers (local stack only) ------------------------------------------
# On Cloud, configure providers in the dashboard (Authentication -> Providers).
# For a local stack, enable the matching [auth.external.*] block in
# supabase/config.toml and set the credentials here.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
